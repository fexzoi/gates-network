# Copy into your hosting provider's secret/environment settings. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MODERATION_API_TOKEN=replace-with-a-long-random-secret
MODERATION_DB_PATH=./moderation_audit.sqlite3

# Wix server-to-server integration (keep private; never add to frontend)
WIX_API_KEY=
WIX_SITE_ID=
WIX_SUBMISSIONS_COLLECTION_ID=gtsSellerSubmissions
# Leave false until API permissions and collection ID are verified
WIX_AUTOMATION_ENABLED=false
